# Ambiente do Docker Compose. Copie este arquivo para .env na raiz.
# Use a conexão de execução já autorizada pela equipe, com TLS.
DATABASE_URL=
JWT_SECRET=
AUDITORIA_CONEXAO_ESTRITA=false
DATABASE_TRANSACTION_TIMEOUT_MS=30000

# A credencial de migrations NÃO pertence a este arquivo.
# Configure constroi_api/.env.migrations quando for aplicar migrations.
